# Application
APP_NAME=RallyOS API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security (change SECRET_KEY in production: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-this-in-production-use-a-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (Project: qaocdecturwknyrbisse)
SUPABASE_URL=https://qaocdecturwknyrbisse.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Supabase PostgreSQL Connection Pooler URI (replace [PASSWORD] and [REGION]):
# DATABASE_URL=postgresql+psycopg2://postgres.qaocdecturwknyrbisse:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# MySQL Database (localhost:3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rallyos
# Optional full connection string override (if set, overrides MYSQL_* fields above)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/rallyos?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# DB_SSL_CA=/path/to/ca.pem

# Rate Limiting, Registration & WebSocket Limits
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_PUBLIC_REGISTER=true
WS_MAX_CONNECTIONS_PER_GAME=100
WS_MAX_TOTAL_CONNECTIONS=2000

# CORS (comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex allowing IP-address origins (local LAN IPs, 127.0.0.1, [::1])
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\]|(?:\d{1,3}\.){3}\d{1,3})(:\d+)?$

